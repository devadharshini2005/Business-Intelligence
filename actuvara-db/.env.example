# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored - never commit real credentials, and never put them in this file.

# Azure Cosmos DB for MongoDB (vCore) connection string.
# Azure portal -> your cluster -> Settings -> Connection strings.
# Use a user that has READ-ONLY rights. Percent-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F). No quotes needed, no trailing ';'.
MONGODB_URI=mongodb://<read-only-user>:<password>@<cluster>.mongocluster.cosmos.azure.com:10260/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000

# Default database the tools use when none is given (falls back to the one in the URI)
MONGODB_DATABASE=intellidoc

# Max rows returned per tool call
MCP_MAX_ROWS=200
