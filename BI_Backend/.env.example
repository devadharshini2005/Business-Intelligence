# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored - never commit real credentials, and never put them in this file.

# Azure Cosmos DB for MongoDB (vCore) connection string.
# Azure portal -> your cluster -> Settings -> Connection strings.
# Use a user that has READ-ONLY rights. Percent-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F). No quotes needed, no trailing ';'.
MONGODB_URI=mongodb://<read-only-user>:<password>@<cluster>.mongocluster.cosmos.azure.com:10260/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000

# Default database the tools use when none is given (falls back to the one in the URI)
MONGODB_DATABASE=intellidoc

# Max rows returned per tool call
MCP_MAX_ROWS=200

# --- BI API (api_server.py) ---------------------------------------------------
# Chatbot model access - fill in ONE of the blocks (the first one with a key is used).
#
# a) Azure OpenAI, e.g. GPT-4.1 deployed in Azure AI Foundry. From the deployment's page:
#    ENDPOINT = the "Azure OpenAI endpoint", e.g. https://<resource>.openai.azure.com/
#    DEPLOYMENT = the deployment name, KEY = the key shown next to the endpoint.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# b) Claude on Microsoft Foundry (Azure): Foundry portal -> your resource -> Keys and Endpoint.
#    RESOURCE is the name in https://<resource>.services.ai.azure.com/anthropic/
#    (or set ANTHROPIC_FOUNDRY_BASE_URL to that full URL instead).
#    CHAT_MODEL is your Claude *deployment name* in Foundry.
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_RESOURCE=
# CHAT_MODEL=claude-opus-5-5
#    Optional: a second Claude deployment to retry on if the main model declines a request
# CHAT_FALLBACK_MODEL=claude-opus-4-8
#
# c) Claude API (platform.claude.com -> API keys)
# ANTHROPIC_API_KEY=

# Optional: effort (low | medium | high)
# CHAT_EFFORT=medium
# Origins allowed to call the API directly (the Angular dev server uses a proxy instead)
# CORS_ORIGINS=http://localhost:4200
